{
  "name": "dsh-side-chat",
  "version": "0.1.2",
  "description": "独立侧聊：继承当前上下文，在右侧提问并保持主会话继续运行",
  "type": "module",
  "license": "Apache-2.0",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host.js",
    "remote.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "side-chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhfgyyf/dsh-side-chat.git"
  },
  "homepage": "https://github.com/yhfgyyf/dsh-side-chat#readme",
  "bugs": {
    "url": "https://github.com/yhfgyyf/dsh-side-chat/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
