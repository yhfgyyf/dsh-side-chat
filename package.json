{
  "name": "dsh-side-chat",
  "version": "0.1.6",
  "description": "\u72ec\u7acb\u4fa7\u804a\uff1a\u7ee7\u627f\u5f53\u524d\u4e0a\u4e0b\u6587\uff0c\u5728\u53f3\u4fa7\u63d0\u95ee\u5e76\u4fdd\u6301\u4e3b\u4f1a\u8bdd\u7ee7\u7eed\u8fd0\u884c",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/package/index.js",
  "exports": {
    ".": "./dist/package/index.js",
    "./client": "./dist/package/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/package",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "side-chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhfgyyf/dsh-side-chat.git"
  },
  "homepage": "https://github.com/yhfgyyf/dsh-side-chat#readme",
  "bugs": {
    "url": "https://github.com/yhfgyyf/dsh-side-chat/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1 || 0.2.1-rc.2 || 0.2.2-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:app": "node scripts/test-app.mjs",
    "test:web": "node scripts/test-app.mjs --web",
    "check": "npm test && npm run build && npm run test:app && npm run test:web"
  },
  "devDependencies": {
    "vite": "8.1.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
